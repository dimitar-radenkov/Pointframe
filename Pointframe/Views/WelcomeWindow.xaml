<Window x:Class="Pointframe.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Pointframe"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackground}"
        Icon="/Assets/icon.ico"
        AutomationProperties.AutomationId="WelcomeWindow.Root">
    <StackPanel Margin="30,26,30,24">
        <TextBlock Text="Welcome to Pointframe" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryText}" />
        <TextBlock Text="Capture anything on your screen in seconds."
                   Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource SecondaryText}" />

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0"
                    Visibility="{Binding IsShortcutAvailable, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Press" FontSize="15" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryText}" />
            <Border Margin="10,0,10,0" Padding="12,5" CornerRadius="5" BorderThickness="1,1,1,3"
                    Background="{DynamicResource KbdBadgeBackground}"
                    BorderBrush="{DynamicResource KbdBadgeBorder}">
                <TextBlock Text="{Binding ShortcutText}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           AutomationProperties.AutomationId="WelcomeWindow.Shortcut" />
            </Border>
            <TextBlock Text="to capture anytime." FontSize="15" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryText}" />
        </StackPanel>
        <TextBlock Text="{Binding ShortcutGuidance}" TextWrapping="Wrap" Margin="0,24,0,0" FontSize="13"
                   Foreground="{DynamicResource WarningText}"
                   AutomationProperties.AutomationId="WelcomeWindow.ShortcutUnavailable">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShortcutAvailable}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="Drag a region, then Copy or Save." Margin="0,14,0,0" FontSize="13"
                   Foreground="{DynamicResource SecondaryText}" />
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource SecondaryText}"
                   Text="Pointframe keeps running in the system tray, next to the clock. Right-click its icon for every capture mode." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Content="Not now" Command="{Binding DismissCommand}"
                    Style="{StaticResource AppSecondaryButton}"
                    AutomationProperties.AutomationId="WelcomeWindow.Dismiss"
                    MinWidth="92" Margin="0,0,10,0" />
            <Button Content="Take your first capture now" Command="{Binding CaptureCommand}"
                    Style="{StaticResource AppPrimaryButton}"
                    AutomationProperties.AutomationId="WelcomeWindow.Capture"
                    MinWidth="220" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
