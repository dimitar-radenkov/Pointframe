<Window x:Class="Pointframe.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trim Recording"
        Width="640" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Background="{DynamicResource WindowBackground}">

    <StackPanel Margin="16">

        <TextBlock Text="{Binding FileName}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,8"/>

        <Border Background="Black" Height="340" Margin="0,0,0,8">
            <MediaElement x:Name="Player"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          ScrubbingEnabled="True"
                          Stretch="Uniform"
                          MediaOpened="Player_MediaOpened"
                          MediaFailed="Player_MediaFailed"/>
        </Border>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayPauseButton"
                    Grid.Column="0"
                    Content="▶"
                    Width="36" Height="26"
                    Margin="0,0,8,0"
                    Click="PlayPause_Click"/>
            <Slider x:Name="PositionSlider"
                    Grid.Column="1"
                    Minimum="0"
                    VerticalAlignment="Center"
                    Thumb.DragStarted="PositionSlider_DragStarted"
                    Thumb.DragCompleted="PositionSlider_DragCompleted"
                    ValueChanged="PositionSlider_ValueChanged"/>
            <TextBlock x:Name="PositionText"
                       Grid.Column="2"
                       Text="00:00.0"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </Grid>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Start" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <Slider Grid.Row="0" Grid.Column="1"
                    Minimum="0"
                    Maximum="{Binding DurationSeconds}"
                    Value="{Binding StartSeconds, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    ValueChanged="StartSlider_ValueChanged"/>
            <TextBlock Text="{Binding StartTimeText}" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button Content="Set to playhead"
                    Grid.Row="0" Grid.Column="3"
                    Padding="8,2" Margin="8,2,0,2"
                    Click="SetStartFromPlayhead_Click"/>

            <TextBlock Text="End" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1"
                    Minimum="0"
                    Maximum="{Binding DurationSeconds}"
                    Value="{Binding EndSeconds, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    ValueChanged="EndSlider_ValueChanged"/>
            <TextBlock Text="{Binding EndTimeText}" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button Content="Set to playhead"
                    Grid.Row="1" Grid.Column="3"
                    Padding="8,2" Margin="8,2,0,2"
                    Click="SetEndFromPlayhead_Click"/>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Content="Cancel"
                    Grid.Column="1"
                    Command="{Binding CancelCommand}"
                    Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Save trimmed copy"
                    Grid.Column="2"
                    Command="{Binding SaveTrimCommand}"
                    Padding="16,6"/>
        </Grid>

    </StackPanel>

</Window>
