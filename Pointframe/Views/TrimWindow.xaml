<Window x:Class="Pointframe.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trim Recording"
        Width="760" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackground}"
        Icon="/Assets/icon.ico">

    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style x:Key="PageDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <Style x:Key="GroupDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Background" Value="{DynamicResource BtnSecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="108"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Trim recording" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageDescription}" Margin="0,6,0,0">
                <Run Text="Review the clip, choose the exact start and end points, and save a shorter copy of "/>
                <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                <Run Text="."/>
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource GroupCard}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Preview" Style="{StaticResource GroupTitle}"/>
                <TextBlock Text="Play the recording and scrub through the timeline before locking the trim range."
                           Style="{StaticResource GroupDescription}"/>

                <Border Background="Black"
                        CornerRadius="6"
                        Height="340"
                        Margin="0,12,0,10"
                        SnapsToDevicePixels="True">
                    <MediaElement x:Name="Player"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  ScrubbingEnabled="True"
                                  Stretch="Uniform"
                                  MediaOpened="Player_MediaOpened"
                                  MediaFailed="Player_MediaFailed"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PlayPauseButton"
                            Grid.Column="0"
                            Content="▶"
                            Margin="0,0,10,0"
                            Style="{StaticResource IconButton}"
                            Click="PlayPause_Click"/>
                    <Slider x:Name="PositionSlider"
                            Grid.Column="1"
                            Minimum="0"
                            VerticalAlignment="Center"
                            Thumb.DragStarted="PositionSlider_DragStarted"
                            Thumb.DragCompleted="PositionSlider_DragCompleted"
                            ValueChanged="PositionSlider_ValueChanged"/>
                    <TextBlock x:Name="PositionText"
                               Grid.Column="2"
                               Text="00:00.0"
                               Style="{StaticResource ValueText}"
                               Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource GroupCard}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Trim range" Style="{StaticResource GroupTitle}"/>
                <TextBlock Text="Set the first and last frame to keep. The preview loops inside the selected range."
                           Style="{StaticResource GroupDescription}"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Start" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
                    <Slider Grid.Row="0" Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding StartSeconds, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ValueChanged="StartSlider_ValueChanged"/>
                    <TextBlock Text="{Binding StartTimeText}"
                               Grid.Row="0"
                               Grid.Column="2"
                               Style="{StaticResource ValueText}"
                               Margin="10,0,0,0"/>
                    <Button Content="Set to playhead"
                            Grid.Row="0"
                            Grid.Column="3"
                            Style="{StaticResource CompactActionButton}"
                            Margin="10,2,0,2"
                            Click="SetStartFromPlayhead_Click"/>

                    <TextBlock Text="End"
                               Grid.Row="1"
                               Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,10,0,0"/>
                    <Slider Grid.Row="1" Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding EndSeconds, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Margin="0,10,0,0"
                            ValueChanged="EndSlider_ValueChanged"/>
                    <TextBlock Text="{Binding EndTimeText}"
                               Grid.Row="1"
                               Grid.Column="2"
                               Style="{StaticResource ValueText}"
                               Margin="10,10,0,0"/>
                    <Button Content="Set to playhead"
                            Grid.Row="1"
                            Grid.Column="3"
                            Style="{StaticResource CompactActionButton}"
                            Margin="10,12,0,2"
                            Click="SetEndFromPlayhead_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusText}"
                       Grid.Column="0"
                       Style="{StaticResource PageDescription}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>
            <Button Content="Cancel"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryBtn}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,8,0"/>
            <Button Content="Save trimmed copy"
                    Grid.Column="2"
                    Style="{StaticResource PrimaryBtn}"
                    MinWidth="150"
                    Command="{Binding SaveTrimCommand}"/>
        </Grid>
    </Grid>

</Window>
