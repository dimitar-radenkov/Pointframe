<Window x:Class="Pointframe.ScrollingCaptureProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Background="Transparent"
        AutomationProperties.AutomationId="ScrollingCaptureProgressWindow.Root">
  <Border Background="{DynamicResource ToolbarBackground}"
          BorderBrush="{DynamicResource ToolbarBorder}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="16,12">
    <Border.Effect>
      <DropShadowEffect Color="#55000000" BlurRadius="16" ShadowDepth="3" Opacity="0.7"/>
    </Border.Effect>
    <Grid MinWidth="290">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock Text="Scrolling capture" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryText}"/>
        <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" FontSize="12"
                   Foreground="{DynamicResource SecondaryText}"
                   AutomationProperties.AutomationId="ScrollingCaptureProgressWindow.Status"/>
        <TextBlock Text="Press Esc to cancel" Margin="0,4,0,0" FontSize="11"
                   Foreground="{DynamicResource SecondaryText}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Cancel" Padding="12,6" VerticalAlignment="Center"
              Command="{Binding CancelCaptureCommand}"
              AutomationProperties.AutomationId="ScrollingCaptureProgressWindow.Cancel"/>
    </Grid>
  </Border>
</Window>
